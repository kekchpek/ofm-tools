#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

if [[ -f "$ROOT/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$ROOT/.env"
  set +a
fi

API_PORT="${API_PORT:-8765}"
WEB_PORT="${WEB_PORT:-5173}"
API_HOST="${API_HOST:-127.0.0.1}"
WEB_HOST="${WEB_HOST:-127.0.0.1}"
UPLOAD_DIR="${UPLOAD_DIR:-$ROOT/data/uploads}"
export UPLOAD_DIR
export JOBS_SYNC="${JOBS_SYNC:-1}"
export CORS_ORIGINS="${CORS_ORIGINS:-http://localhost:${WEB_PORT},http://127.0.0.1:${WEB_PORT}}"
export FRONTEND_URL="${FRONTEND_URL:-http://localhost:${WEB_PORT}}"
export GOOGLE_REDIRECT_URI="${GOOGLE_REDIRECT_URI:-http://localhost:${WEB_PORT}/api/v1/auth/google/callback}"

PYTHON="${PYTHON:-python3}"
if [[ -x "$ROOT/.venv/bin/python" ]]; then
  PYTHON="$ROOT/.venv/bin/python"
fi

usage() {
  cat <<EOF
Usage: ./start_server [options]

Start the Content Metadata Changer web stack (API + frontend dev server).

Options:
  --api-only     Start only the API server
  --web-only     Start only the frontend dev server
  --no-reload    Disable API auto-reload
  -h, --help     Show this help

Environment:
  API_PORT       API listen port (default: 8765)
  WEB_PORT       Web dev server port (default: 5173)
  UPLOAD_DIR     Upload storage directory (default: data/uploads)
  JOBS_SYNC      Run jobs synchronously (default: 1)

Examples:
  ./start_server
  ./start_server --api-only
  API_PORT=9000 ./start_server
EOF
}

START_API=1
START_WEB=1
USE_RELOAD=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --api-only)
      START_WEB=0
      ;;
    --web-only)
      START_API=0
      ;;
    --no-reload)
      USE_RELOAD=0
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

if [[ "$START_API" -eq 0 && "$START_WEB" -eq 0 ]]; then
  echo "Nothing to start." >&2
  exit 1
fi

if [[ "$START_API" -eq 1 ]]; then
  if ! "$PYTHON" -c "import uvicorn" 2>/dev/null; then
    echo "Missing Python dependencies. Run:" >&2
    echo "  $PYTHON -m pip install -r requirements.txt -r requirements-api.txt" >&2
    exit 1
  fi
fi

if [[ "$START_WEB" -eq 1 ]]; then
  if ! command -v npm >/dev/null 2>&1; then
    echo "npm is required for the web frontend." >&2
    exit 1
  fi
fi

mkdir -p "$UPLOAD_DIR"

API_PID=""
WEB_PID=""

cleanup() {
  if [[ -n "$WEB_PID" ]] && kill -0 "$WEB_PID" 2>/dev/null; then
    kill "$WEB_PID" 2>/dev/null || true
    wait "$WEB_PID" 2>/dev/null || true
  fi
  if [[ -n "$API_PID" ]] && kill -0 "$API_PID" 2>/dev/null; then
    kill "$API_PID" 2>/dev/null || true
    wait "$API_PID" 2>/dev/null || true
  fi
}

trap cleanup EXIT INT TERM

if [[ "$START_API" -eq 1 ]]; then
  echo "Starting API on http://${API_HOST}:${API_PORT}"
  if [[ -n "${GOOGLE_CLIENT_ID:-}" ]]; then
    echo "Google OAuth redirect URI (register in Google Cloud Console):"
    echo "  ${GOOGLE_REDIRECT_URI}"
  fi
  if [[ "$USE_RELOAD" -eq 1 ]]; then
    "$PYTHON" -m uvicorn api.main:app \
      --host "$API_HOST" \
      --port "$API_PORT" \
      --reload &
  else
    "$PYTHON" -m uvicorn api.main:app \
      --host "$API_HOST" \
      --port "$API_PORT" &
  fi
  API_PID=$!
fi

if [[ "$START_WEB" -eq 1 ]]; then
  cd "$ROOT/web"
  if [[ ! -d node_modules ]]; then
    echo "Installing web dependencies..."
    npm install
  fi
  echo "Starting web UI on http://${WEB_HOST}:${WEB_PORT}"
  npm run dev -- --host "$WEB_HOST" --port "$WEB_PORT" &
  WEB_PID=$!
  cd "$ROOT"
fi

echo
if [[ "$START_WEB" -eq 1 ]]; then
  echo "Open http://${WEB_HOST}:${WEB_PORT}"
fi
if [[ "$START_API" -eq 1 ]]; then
  echo "API health: http://${API_HOST}:${API_PORT}/api/v1/health"
fi
echo "Press Ctrl+C to stop."
echo

if [[ -n "$WEB_PID" ]]; then
  wait "$WEB_PID"
elif [[ -n "$API_PID" ]]; then
  wait "$API_PID"
fi
