# Copy to .env and fill in values. Never commit .env.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback
# Reserved. Session tokens are random UUID4 values stored server-side, so
# nothing is signed with this today — setting it does not affect security.
AUTH_SECRET=
FRONTEND_URL=http://localhost:5173
DATABASE_PATH=data/app.db
AUTH_SESSION_TTL_HOURS=168
AUTH_COOKIE_SECURE=0
# Use "none" when frontend and API are on different origins (Railway + Cloudflare Pages).
AUTH_COOKIE_SAMESITE=lax

UPLOAD_DIR=data/uploads
JOBS_SYNC=1
# Set to 0 in production to stop /docs, /redoc and /openapi.json from
# enumerating every endpoint to anonymous callers.
ENABLE_API_DOCS=1
# Per-user storage ceiling for saved OFM Factory pieces (default 2 GB).
USER_STORAGE_QUOTA_BYTES=2147483648
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production (Railway) — see docs/DEPLOY_RAILWAY_CLOUDFLARE.md
# VITE_API_BASE=https://your-api.up.railway.app
