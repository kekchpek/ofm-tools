# Copy to .env and fill in values. Never commit .env.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback
AUTH_SECRET=
FRONTEND_URL=http://localhost:5173
DATABASE_PATH=data/app.db
AUTH_SESSION_TTL_HOURS=168
AUTH_COOKIE_SECURE=0
# Use "none" when frontend and API are on different origins (Railway + Cloudflare Pages).
AUTH_COOKIE_SAMESITE=lax

UPLOAD_DIR=data/uploads
JOBS_SYNC=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production (Railway) — see docs/DEPLOY_RAILWAY_CLOUDFLARE.md
# VITE_API_BASE=https://your-api.up.railway.app
